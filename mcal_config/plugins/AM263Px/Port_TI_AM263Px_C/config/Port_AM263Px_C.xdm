<?xml version='1.0'?>
<datamodel version="3.0"
           xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
           xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

	<d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd"
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd" >
		<d:lst type="TOP-LEVEL-PACKAGES">
			<d:ctr name="TI_AM263Px" type="AR-PACKAGE">
				<d:lst type="ELEMENTS">
					<d:chc name="Port" type="AR-ELEMENT" value="MODULE-DEF">
						<v:ctr type="MODULE-DEF">
							<a:a name="ADMIN-DATA" type="ADMIN-DATA">
								<ad:ADMIN-DATA>
									<ad:DOC-REVISIONS>
										<ad:DOC-REVISION>
											<ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
											<ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
											<ad:DATE>2016-07-30</ad:DATE>
										</ad:DOC-REVISION>
									</ad:DOC-REVISIONS>
								</ad:ADMIN-DATA>
							</a:a>
							<a:a name="DESC" value="EN: Configuration of the Port module."/>
							<a:a name="LOWER-MULTIPLICITY" value="1"/>
							<a:a name="RELEASE" value="asc:4.3.1"/>
							<a:a name="UPPER-MULTIPLICITY" value="1"/>
							<a:a name="UUID" value="0b406387-5b49-4529-b619-f89435846b09"/>
							<v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
								<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                            type="IMPLEMENTATIONCONFIGCLASS">
									<icc:v class="PreCompile">VariantPostBuild</icc:v>
									<icc:v class="PreCompile">VariantPreCompile</icc:v>
								</a:a>
								<a:a name="LABEL" value="Config Variant"/>
								<a:a name="UUID" value="0c861398-c278-453f-abf0-42cfafa7e2e8"/>
								<a:da name="DEFAULT" value="VariantPostBuild"/>
								<a:da name="RANGE">
									<a:v>VariantPostBuild</a:v>
									<a:v>VariantPreCompile</a:v>

								</a:da>
							</v:var>
							<v:lst name="PortConfigSet"
                                        type="MULTIPLE-CONFIGURATION-CONTAINER">
								<a:da name="MIN" value="1"/>
								<v:ctr name="PortConfigSet"
                                                type="MULTIPLE-CONFIGURATION-CONTAINER">
									<a:a name="DESC"
                                        value="EN: This container contains the multiple configuration set and sub containers of the AUTOSAR Port module"/>
									<a:a name="UUID" value="2c6554e5-e43e-4eb3-aedf-0d5a8fe2f980"/>
									<a:a name="REQUIRES-INDEX" value="true"/>
									<v:lst name="PortContainer" type="MAP">
										<a:da name="MIN" value="1"/>
										<v:ctr name="PortContainer" type="IDENTIFIABLE">
											<a:a name="DESC"
                                                    value="EN: Container collecting the PortPins."/>
											<a:a name="UUID"
                                                value="f6e8ee09-a25f-4520-aebb-ea4561c0f22b"/>
												<a:a name="REQUIRES-INDEX" value="true"/>
											<v:var name="PortNumberOfPortPins" type="INTEGER">
												<a:a name="DESC"
                                                value="EN: The number of specified PortPins in this PortContainer."/>
												<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
													<icc:v class="PreCompile">VariantPostBuild</icc:v>
													<icc:v class="PreCompile">VariantPreCompile</icc:v>
												</a:a>
												<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
												<a:a name="SCOPE" value="LOCAL"/>
												<a:a name="SYMBOLICNAMEVALUE" value="false"/>
												<a:a name="UUID"
                                                    value="45685640-4d91-4ed0-85fd-5d9f428310d8"/>
												<a:da name="INVALID" type="Range">
													<a:tst expr="&lt;=65535"/>
													<a:tst expr="&gt;=1"/>
												</a:da>
												<a:da name="DEFAULT" type="XPath" expr="num:i(count(../PortPin/*))"/>
											</v:var>
											<v:lst name="PortPin" type="MAP">
												<a:da name="MIN" value="1"/>
												<v:ctr name="PortPin" type="IDENTIFIABLE">
													<a:a name="DESC"
                                                            value="EN: Configuration of the individual port pins."/>
													<a:a name="UUID"
                                                    value="ee508de0-6ae3-4b01-8d4a-c9cb1a1b2f83"/>
													<a:a name="REQUIRES-INDEX" value="true"/>





													<v:var name="PortPinPeripheral" type="ENUMERATION">
														<a:a name="DESC"
                                                        value="EN: Select peripheral of interest to narron down list of pins of interest"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="1e18446d-28b4-44eb-ae72-684ad28c3229"/>
														<a:da name="RANGE" type="XPath" expr="ecu:list('Port_TI_AM263Px_Peripherals')"/>
                                                    </v:var>
													<v:var name="PortPinPeripheralSignal" type="ENUMERATION">
														<a:a name="DESC"
                                                            value="EN: Select specific peripheral signal pin of interest"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="0083e89e-6198-4679-8132-4dd624a948e3"/>
														<a:da name="RANGE" type="XPath" expr="ecu:list(concat('Port_TI_AM263Px_Signals_',node:value(../PortPinPeripheral)))"/>
													</v:var>
													<v:var name="PortPinName" type="ENUMERATION">
														<a:a name="DESC"
                                                        value="EN: PAD IO name of the selected pin"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                    type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PreCompile">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>
														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                                        value="1d06e69d-49b3-47fc-b5b1-4e1cd6604635"/>
														<a:da name="RANGE" type="XPath" expr="ecu:list(concat('Port_TI_AM263Px_Pins_',node:value(../PortPinPeripheralSignal)))"/>
														<a:da name="ENABLE" value = "true"/>
														<a:da name="INVALID" type="XPath" expr="text:uniq((../../../..//*[@name='PortPinName']),node:value(.))" false="Port Pin selection has to be unique across all PortConfig comntainers"/>
													</v:var>
													<v:var name="PortPinId" type="INTEGER">
														<a:a name="DESC"
                                                            value="EN: Pin Id of the port pin. This value will be assigned to the symbolic name derived from the port pin container short name."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                    type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PreCompile">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>
														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="true"/>
														<a:a name="UUID"
                                                        value="028a9bd4-df7a-4bef-a905-e3945d0bb75d"/>
														<!--<a:da name="DEFAULT" type="XPath" expr="num:i(string-length(substring-before(ecu:get('Port_TI_AM263Px_Pins'),node:value(../PortPinName))) - string-length(translate(substring-before(ecu:get('Port_TI_AM263Px_Pins'),node:value(../PortPinName)),',','')) + 1)" />-->

														<a:da name="DEFAULT" type="XPath" expr="num:i(number(ecu:get(concat('Port_TI_AM263Px_PinId_',node:value(../PortPinName)))))"/>
														<a:da name="ENABLE" value = "true"/>
													</v:var>
													<v:var name="PortPinIdAddr" type="STRING">
														<a:a name="DESC"
                                                             value="EN: Pin Id of the port pin. This value will be assigned to the symbolic name derived from the port pin container short name."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PreCompile">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>
														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                              value="a577a4d7-bf17-4a4e-8550-f0c9163a014a"/>
														<a:da name="DEFAULT" type="XPath" expr="ecu:get(concat('Port_TI_AM263Px_',node:value(../PortPinName),'.Addr'))"/>
														<a:da name="ENABLE" value = "true"/>
													</v:var>
													<v:var name="PortPinDirection" type="ENUMERATION">
														<a:a name="DESC"
                                                            value="EN: The initial direction of the pin (IN or OUT). If the direction is not changeable, the value configured here is fixed."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                                value="a430393b-d482-4948-aaa7-23b8666e4416"/>
														<a:da name="RANGE">
															<a:v>PORT_PIN_IN</a:v>
															<a:v>PORT_PIN_OUT</a:v>
															<a:v>PORT_PIN_DEFAULT</a:v>
														</a:da>
														<a:da name="DEFAULT" value="PORT_PIN_DEFAULT"/>
													</v:var>
													<v:var name="PortPinDirectionChangeable" type="BOOLEAN">
														<a:a name="DESC"
                                                        value="EN: Parameter to indicate if the direction is changeable on a port pin during runtime."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="13d8654f-ec4f-4eb3-8cad-1c94cc460907"/>
														<a:da name="DEFAULT" value="false"/>
													</v:var>
													<v:var name="PortPinInitialMode" type="ENUMERATION">
														<a:a name="DESC"
                                                        value="EN: Port pin mode from mode list for use with Port_Init() function."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="fb7de085-fb90-4ee8-8303-ef29ee96b648"/>
														<a:da name="RANGE" type="XPath" expr="ecu:list('Port_TI_AM263Px_Peripherals')"/>
														<a:da name="DEFAULT" type="XPath" expr="node:value(../PortPinPeripheral)"/>
													</v:var>
													<v:var name="PortPinInitialGpioMuxmode" type="ENUMERATION">
														<a:a name="DESC"
                                                        value="EN: Port pin gpio muxmode from mode list for use with Port_Init() function."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="ddeff37c-ccad-411b-8814-10ea4a479d44"/>
														<a:da name="RANGE" type="XPath" expr="node:when(starts-with(node:value(../PortPinInitialMode), 'GPIO'),text:grep( ecu:list(concat('Port_TI_AM263Px_', node:value(../PortPinName), '.Func')),'^GPIO\d+_MUXMODE_\d\d?$'),('NULL'))"/>
														<a:da name="DEFAULT" type="XPath" expr="node:when(starts-with(node:value(../PortPinInitialMode), 'GPIO'),text:grep( ecu:list(concat('Port_TI_AM263Px_', node:value(../PortPinName), '.Func')),'^GPIO\d+_MUXMODE_\d\d?$'),('NULL'))"/>
													</v:var>
													<v:var name="PortPinLevelValue" type="ENUMERATION">
														<a:a name="DESC"
                                                            value="EN: Port Pin Level value from Port pin list."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                                value="43362097-e501-4f35-bd35-80e7eb029a15"/>
														<a:da name="RANGE">
															<a:v>PORT_PIN_LEVEL_HIGH</a:v>
															<a:v>PORT_PIN_LEVEL_LOW</a:v>
														</a:da>
														<a:da name="DEFAULT" value="PORT_PIN_LEVEL_HIGH"/>
													</v:var>
													<v:lst name="PortPinMode">
														<a:da name="MIN" value="1"/>
														<a:da name="MAX" type="XPath" expr="node:when(node:value(../PortPinModeChangeable),count(ecu:list(concat('Port_TI_AM263Px_',node:value(../PortPinName),'.Func'))),1)"/>
														<v:var name="PortPinMode" type="ENUMERATION">
															<a:a name="DESC"
                                                                value="EN: Port pin mode from mode list."/>
															<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                    type="IMPLEMENTATIONCONFIGCLASS">
																<icc:v class="PostBuild">VariantPostBuild</icc:v>
																<icc:v class="PreCompile">VariantPreCompile</icc:v>

															</a:a>
															<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
															<a:a name="SCOPE" value="LOCAL"/>
															<a:a name="SYMBOLICNAMEVALUE" value="false"/>
															<a:a name="UUID"
                                                                        value="cd628776-d9eb-4a7f-aa6b-c9f9891f644d"/>
															<a:da name="RANGE" type="XPath" expr="node:when(node:value(../../PortPinModeChangeable),ecu:list(concat('Port_TI_AM263Px_',node:value(../../PortPinName),'.Func')),text:grep(ecu:list(concat('Port_TI_AM263Px_',node:value(../../PortPinName),'.Func')),concat('^',node:value(../../PortPinPeripheralSignal),'_MUXMODE_\d\d?$')))"/>
															<a:da name="DEFAULT" type="XPath" expr="node:when(node:value(../../PortPinModeChangeable),ecu:list(concat('Port_TI_AM263Px_',node:value(../../PortPinName),'.Func'))[position()-1 = node:current()/@index],text:grep(ecu:list(concat('Port_TI_AM263Px_',node:value(../../PortPinName),'.Func')),concat('^',node:value(../../PortPinPeripheralSignal),'_MUXMODE_\d\d?$')))"/>
														</v:var>
													</v:lst>
													<v:var name="PortPinModeChangeable" type="BOOLEAN">
														<a:a name="DESC"
                                                            value="EN: Parameter to indicate if the mode is changeable on a port pin during runtime. True: Port Pin mode changeable allowed. False: Port Pin mode changeable not permitted."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                                    value="af0c83e2-1880-4f3e-b9d3-a0c7228ee7fc"/>
														<a:da name="DEFAULT" value="false"/>
													</v:var>
													<v:var name="PortPinInhibitEnable" type="ENUMERATION">
														<a:a name="DESC"
                                                                value="EN: The port pin inhibit enable."/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                                type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="34ac0339-f426-477d-9320-ad5717bb0cb6"/>
														<a:da name="RANGE">
															<a:v>PORT_PIN_PULL_INHIBIT_ENABLE</a:v>
															<a:v>PORT_PIN_PULL_INHIBIT_DISABLE</a:v>
															<a:v>PORT_PIN_PULL_INHIBIT_DEFAULT</a:v>
														</a:da>
														<a:da name="DEFAULT" value="PORT_PIN_PULL_INHIBIT_DISABLE"/>
													</v:var>
                                                    <v:var name="PortPullTypeSelect" type="ENUMERATION">
														<a:a name="DESC" value="EN: Type of PULL U/D selection "/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">

															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="OPTIONAL" value="false"/>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID" value="25fd0ae0-25e8-4215-a70c-524aa73b3bb2"/>
														<a:da name="ENABLE" value="true"/>
														<a:da name="DEFAULT" value="PORT_PIN_PULLTYPE_PULLDOWN"/>
														<a:da name="RANGE">
															<a:v>PORT_PIN_PULLTYPE_PULLDOWN</a:v>
															<a:v>PORT_PIN_PULLTYPE_PULLUP</a:v>
															<a:v>PORT_PIN_PULLTYPE_DEFAULT</a:v>
														</a:da>
													</v:var>
													<v:var name="PortPinHSmasterEnable" type="BOOLEAN">
														<a:a name="DESC"
                                                        value="EN: Parameter to enable HSMASTER"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>
														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="a5c136f9-4704-417b-a8c4-7ba9dfbd652e"/>
														<a:da name="DEFAULT" value="false"/>
                    									<a:da name="ENABLE" value="false"/>
                    									<a:da name="EDITABLE" value="false"/>
													</v:var>
													<v:var name="PortPinHSmodeEnable" type="BOOLEAN">
														<a:a name="DESC"
                                                        value="EN: Parameter to enable HSMODE"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                        type="IMPLEMENTATIONCONFIGCLASS">
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>
														</a:a>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID"
                                                            value="2969524f-c52f-42b9-9285-b499352b83cd"/>
														<a:da name="DEFAULT" value="false"/>
                    									<a:da name="ENABLE" value="false"/>
                    									<a:da name="EDITABLE" value="false"/>
													</v:var>
													<v:var name="PortInputInversionSelect" type="ENUMERATION">
														<a:a name="DESC" value="EN: Parameter to select port pin inversion (select value for chosing inverted version of PAD input for chip)"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">

															<icc:v class="PostBuild">VariantPostBuild</icc:v>
															<icc:v class="PreCompile">VariantPreCompile</icc:v>

														</a:a>
														<a:a name="OPTIONAL" value="false"/>
														<a:a name="ORIGIN" value="Texas Instruments"/>
														<a:a name="SCOPE" value="LOCAL"/>
														<a:a name="SYMBOLICNAMEVALUE" value="false"/>
														<a:a name="UUID" value="b1dc41ba-d77f-4707-a935-1dc6462b459d"/>
														<a:da name="ENABLE" value="true"/>
														<a:da name="DEFAULT" value="PORT_INVTYPE_DEFAULT"/>
														<a:da name="RANGE">
															<a:v>PORT_INV</a:v>
															<a:v>PORT_NONINV</a:v>
															<a:v>PORT_INVTYPE_DEFAULT</a:v>
														</a:da>
