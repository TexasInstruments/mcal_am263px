															<a:v>PORT_PIN_DISABLE_OUTPUT_OVERRIDE</a:v>
															<a:v>PORT_PIN_ENABLE_OUTPUT_OVERRIDE</a:v>
															<a:v>PORT_PIN_OUTPUT_RETAIN_HW_CTRL</a:v>
														</a:da>
													</v:var>
													<v:var name="PortGpioOwnerCore" type="INTEGER">
                                                        <a:a name="DESC"
                                                            value="EN: PIN ownership of GPIO. 0 - R5FSS0 Core0, 1 - R5FSS0 Core1, 2 - R5FSS1 Core0, 3 - R5FSS1 Core1"/>
                                                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                            type="IMPLEMENTATIONCONFIGCLASS">
                                                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                        </a:a>
                                                        <a:a name="ORIGIN" value="Texas Instruments"/>
                                                        <a:a name="SCOPE" value="LOCAL"/>
                                                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                        <a:a name="UUID" value="4a872b39-08f6-4958-941e-d694e167e8ff"/>
                                                        <a:da name="DEFAULT" type="XPath" expr="node:value(as:modconf('Port')[1]/PortGeneral/PortGpioHostCoreId)"/>
                                                        <a:da name="INVALID" type="Range">
                                                            <a:tst expr="&lt;=3"/>
                                                            <a:tst expr="&gt;=0"/>
                                                        </a:da>
                                                    </v:var>
												</v:ctr>
											</v:lst>
										</v:ctr>
									</v:lst>
									<v:lst name="PortDioConfig" type="MAP">
										<a:da name="MAX" value="138"/>
										<a:da name="MIN" value="0"/>
										<v:ctr name="PortDioConfig" type="IDENTIFIABLE">
											<a:a name="UUID" value="19e1f090-c8e6-4db1-b60e-5a7f20ccc206"/>
											<a:a name="DESC" value="EN: Structure for GPIO Interrupt configuration"/>
											<a:da name="ENABLE" value="true"/>
											<v:var name="PortDioPinNumber" type="INTEGER">
												<a:a name="DESC" value="EN: Port GPIO Pin Numbers (0 to 138)"/>
