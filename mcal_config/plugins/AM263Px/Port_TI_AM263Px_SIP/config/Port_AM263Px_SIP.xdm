												<a:a name="UUID" value="87ac8241-8113-43cf-aad8-6ee81360140e"/>
												<a:da name="DEFAULT" value="0"/>
												<a:da name="INVALID" type="XPath">
                                                    <a:tst expr="(((node:value(../PortDioPinNumber)) &gt;=139) ) " true=" Invalid Pin Number : [ GPIO Pin Range (0 to 138) ] "/>
												</a:da>
                                                <a:da name="VISIBLE" value="true"/>
											</v:var>
											<v:var name="PortPinSelectEdgeTrigger" type="ENUMERATION">
												<a:a name="DESC" value="EN: Type of EdgeTrigger selection "/>
												<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
													<icc:v class="PostBuild">VariantPostBuild</icc:v>
													<icc:v class="PreCompile">VariantPreCompile</icc:v>
												</a:a>
												<a:a name="ORIGIN" value="Texas Instruments"/>
												<a:a name="UUID" value="1eada6db-6499-47da-904a-ee07b7ecceb4"/>
												<a:da name="DEFAULT" value="PORT_RISING_EDGE"/>
												<a:da name="RANGE">
													<a:v>PORT_RISING_EDGE</a:v>
													<a:v>PORT_FALLING_EDGE</a:v>
													<a:v>PORT_BOTH_EDGE</a:v>
												</a:da>
											</v:var>
											<v:var name="PortPinSelectInterruptType" type="ENUMERATION">
												<a:a name="DESC" value="EN: Select Interrupt type "/>
												<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
													<icc:v class="PostBuild">VariantPostBuild</icc:v>
													<icc:v class="PreCompile">VariantPreCompile</icc:v>
												</a:a>
												<a:a name="ORIGIN" value="Texas Instruments"/>
												<a:a name="UUID" value="eb2f3049-8c2e-4376-954e-0dd3ff55e4d6"/>
												<a:da name="DEFAULT" value="PORT_BANK_INTR"/>
												<a:da name="RANGE">
													<a:v>PORT_CHANNEL_INTR</a:v>
													<a:v>PORT_BANK_INTR</a:v>
												</a:da>
											</v:var>
											<v:var name="PortDioInterruptNotification" type="FUNCTION-NAME">
                                               <a:a name="DESC"
                                                    value="EN: Definition of the Callback function."/>
                                               <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                                 <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                                                 <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                                               </a:a>
                                               <a:a name="ORIGIN" value="Texas Instruments"/>
                                               <a:a name="UUID" value="ECUC:f84915aa-b536-4441-9f0d-b109d18e5ad7"/>
                                               <a:da name="DEFAULT" value="NULL_PTR"/>
                                               <a:da name="ENABLE" value="true"/>
                                            </v:var>

											<v:ref name="PortMcuGpioXbarReference" type="REFERENCE">
												<a:a name="DESC" value="EN: Reference to the McuGpioXbarIntrConfiguration container"/>
												<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
													<icc:v class="PostBuild">VariantPostBuild</icc:v>
													<icc:v class="PreCompile">VariantPreCompile</icc:v>
												</a:a>
