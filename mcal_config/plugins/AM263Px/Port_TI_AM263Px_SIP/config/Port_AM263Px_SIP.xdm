									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="c3b17f71-b074-4375-a077-7a72f1915df1"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortVersionInfoApi" type="BOOLEAN">
									<a:a name="DESC"
                                        value="EN: Pre-processor switch to enable / disable the API to read out the modules version information."/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="d45e4091-7e06-49af-ad6b-9fd6f6386456"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortRefreshPortDirectionApi" type="BOOLEAN">
									<a:a name="DESC"
                                                    value="EN: Pre-processor switch to enable / disable the API to refresh the port direction."/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID"
                                        value="ECUC:b3bf2f24-e20e-403f-be61-bad0ac98cca7"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortDefaultOSCounterId" type="INTEGER">
								  <a:a name="DESC" value="EN: Default Os Counter Id if node reference to OsCounter ref PortOsCounterRef is not set"/>
								  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
									<icc:v class="PreCompile">VariantPostBuild</icc:v>
									<icc:v class="PreCompile">VariantPreCompile</icc:v>
								  </a:a>
								  <a:a name="ORIGIN" value="Texas Instruments"/>
								  <a:a name="UUID" value="09c3b5a5-1f7c-45b6-9a4b-cb81b5019bc3"/>
								  <a:da name="INVALID" type="Range">
									<a:tst expr="&lt;=16"/>
									<a:tst expr="&gt;=0"/>
								  </a:da>
								  <a:da name="DEFAULT" value="0"/>
                                  <a:da name="ENABLE" type="XPath" expr="not(node:refexists(../PortOsCounterRef))"/>
								</v:var>
								<v:var name="PortSafeTIApi" type="BOOLEAN">
									<a:a name="DESC"
                                            value="EN: Enable/Disable SAFETI Configuration register readback."/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                    type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="ECUC:cb2d3d00-1bee-4720-8c52-0af8c42688ee"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortEnableIntrApi" type="BOOLEAN">
									<a:a name="DESC"
                                            value="EN: Pre-processor switch to enable / disable the use of Interrupt Functionality"/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="ec1b077a-5c4f-47f0-a32e-eb84fa92f073"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortGetIntrStatusApi" type="BOOLEAN">
									<a:a name="DESC"
                                            value="EN: Pre-processor switch to enable / disable the use of Port_GetInterruptStatus API"/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="dac6e28f-454d-4af6-aa1f-daff47b108ad"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:var name="PortClearIntrStatusApi" type="BOOLEAN">
									<a:a name="DESC"
                                            value="EN: Pre-processor switch to enable / disable the use of Port_ClearInterruptStatus API"/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="SYMBOLICNAMEVALUE" value="false"/>
									<a:a name="UUID" value="0cd1f0d5-d7bb-4543-94e7-c60ea29bd5bf"/>
									<a:da name="DEFAULT" value="true"/>
								</v:var>
								<v:ref name="PortOsCounterRef" type="REFERENCE">
									<a:a name="DESC"
                                                value="EN: This parameter contains a reference to the OsCounter, which is used by the PORT driver."/>
									<a:a name="IMPLEMENTATIONCONFIGCLASS"
                                            type="IMPLEMENTATIONCONFIGCLASS">
										<icc:v class="PreCompile">VariantPostBuild</icc:v>
										<icc:v class="PreCompile">VariantPreCompile</icc:v>
									</a:a>
									<a:a name="OPTIONAL" value="true"/>
									<a:a name="ORIGIN" value="Texas Instruments"/>
									<a:a name="SCOPE" value="LOCAL"/>
									<a:a name="UUID" value="666399b7-86e8-49bc-9ab9-cf4fac5d19ef"/>
									<a:da name="REF"
                                                    value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Os/OsCounter"/>
									<a:da name="ENABLE" value="true"/>
									<a:da name="EDITABLE" value="true"/>
									<a:da name="READONLY" value="false"/>
									<a:da name="VISIBLE" value="true"/>
								</v:ref>
								<v:var name="PortTimeoutDuration" type="INTEGER">
								  <a:a name="DESC" value="EN: PORT timeout - used in PORT busy wait"/>
								  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
									<icc:v class="PreCompile">VariantPostBuild</icc:v>
									<icc:v class="PreCompile">VariantPreCompile</icc:v>
