														<a:da name="RANGE">
															<a:v>PORT_PIN_DISABLE_INPUT_OVERRIDE</a:v>
															<a:v>PORT_PIN_ENABLE_INPUT_OVERRIDE</a:v>
															<a:v>PORT_PIN_INPUT_RETAIN_HW_CTRL</a:v>
														</a:da>
													</v:var>
													<v:var name="PortOutputOverrideCtrl" type="ENUMERATION">
														<a:a name="DESC" value="EN: Port OutputOverride control (Keep these value as PORT_PIN_DISABLE_OUTPUT_OVERRIDE while configuring pin as a GPIO)"/>
														<a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">

															<icc:v class="PreCompile">VariantPreCompile</icc:v>
															<icc:v class="PostBuild">VariantPostBuild</icc:v>
