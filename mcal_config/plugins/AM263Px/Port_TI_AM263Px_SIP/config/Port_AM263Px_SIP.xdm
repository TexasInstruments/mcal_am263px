									<a:tst expr="&lt;=4294967295"/>
									<a:tst expr="&gt;=1"/>
								  </a:da>
								  <a:da name="DEFAULT" value="32000"/>
								</v:var>

								<v:var name="PortTypeofInterruptFunction" type="ENUMERATION">
								  <a:a name="DESC" value="EN: Type of ISR function"/>
								  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
								    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  </a:a>
                                  <a:a name="ORIGIN" value="Texas Instruments"/>
                                  <a:a name="UUID" value="ECUC:dc615eca-69be-4eb0-ac60-f8914c8c5a87"/>
                                  <a:da name="DEFAULT" value="PORT_ISR_CAT1"/>
                                  <a:da name="RANGE">
                                    <a:v>PORT_ISR_VOID</a:v>
                                    <a:v>PORT_ISR_CAT1</a:v>
                                    <a:v>PORT_ISR_CAT2</a:v>
								  </a:da>
								</v:var>
								<v:var name="PortGpioHostCoreId" type="INTEGER">
								<a:a name="DESC"
									value="EN: R5F CPU ownership of GPIO. 0 - R5FSS0 Core0, 1 - R5FSS0 Core1, 2 - R5FSS1 Core0, 3 - R5FSS1 Core1"/>
								<a:a name="IMPLEMENTATIONCONFIGCLASS"
									type="IMPLEMENTATIONCONFIGCLASS">
