                  <SHORT-NAME>EthTrcvVersionInfoApi</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Enables / Disables version info API</L-2>
                  </DESC>
                  <SCOPE>LOCAL</SCOPE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
