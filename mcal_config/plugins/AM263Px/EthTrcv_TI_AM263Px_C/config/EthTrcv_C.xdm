<?xml version='1.0'?>
<datamodel version="6.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/14/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/14/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="TI_AM263Px" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:42e9ca54-6c51-4adb-82a7-b7b8ca8537e3"/>
        <d:lst type="ELEMENTS">
          <d:chc name="EthTrcv" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.6.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                      <ad:DATE>2014-10-31</ad:DATE>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC" 
                   value="EN: Configuration of Ethernet Transceiver Driver module"/>
              <a:a name="LOWER-MULTIPLICITY" value="0"/>
              <a:a name="POSTBUILDVARIANTSUPPORT" value="true"/>
              <a:a name="RELEASE" value="asc:4.3.1"/>
              <a:a name="UPPER-MULTIPLICITY" value="*"/>
              <a:a name="UUID" value="ECUC:f20e2228-4ebe-443a-a898-fbff8c768b37"/>
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                     type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                  <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:a name="LABEL" value="Config Variant"/>
                <a:da name="DEFAULT" value="VariantLinkTime"/>
                <a:da name="RANGE">
                  <a:v>VariantLinkTime</a:v>
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
              <v:ctr name="EthTrcvConfigSet" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: This container contains the configuration parameters and sub containers of the AUTOSAR EthTrcv module."/>
                <a:a name="UUID" 
                     value="ECUC:11732ffd-9d5f-4398-a43e-a86942e1cc1a"/>
                <v:lst name="EthTrcvConfig" type="MAP">
                  <a:da name="MIN" value="1"/>
                  <v:ctr name="EthTrcvConfig" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: Configuration of the individual transceiver"/>
                    <a:a name="UUID" 
                         value="ECUC:a8f707b1-608f-4b4d-a51a-5ea718ef1a35"/>
                    <v:var name="EthTrcvAutoNegotiationEnabled" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Specifies if Auto-Negotiation is enabled (TRUE) or disabled (FALSE) for determination of the Ethernet transceiver speed."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:3438a5b5-5433-4296-92b2-d7d2332bcda1"/>
                      <a:da name="DEFAULT" value="true"/>
                    </v:var>
                    <v:var name="EthTrcvConnNeg" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: Specifies the connection negotiation of the Ethernet transceiver link."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:9d91411b-136b-4d02-9349-4cc3a0663ccc"/>
                      <a:da name="DEFAULT" value="TRCV_CONN_NEG_AUTO"/>
                      <a:da name="RANGE">
                        <a:v>TRCV_CONN_NEG_AUTO</a:v>
                        <a:v>TRCV_CONN_NEG_MASTER</a:v>
                        <a:v>TRCV_CONN_NEG_SLAVE</a:v>
                      </a:da>
                    </v:var>
                    <v:var name="EthTrcvCtrlIdx" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: Specifies the controller used for MII access to the transceiver"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:870d0cd6-f9d2-45cd-9963-3a4b3813a7ca"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=255"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:var name="EthTrcvDuplexMode" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: Specifies the duplex mode of the Ethernet transceiver link if Auto-Negotiation is disabled. This parameter is ignored if Auto-Negotiation is enabled."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:5d8c1c9a-9dab-48b6-947b-e1abf4d4ebeb"/>
                      <a:da name="RANGE">
                        <a:v>ETHTRCV_DUPLEX_MODE_FULL</a:v>
                        <a:v>ETHTRCV_DUPLEX_MODE_HALF</a:v>
                      </a:da>
                      <a:da name="DEFAULT" value="ETHTRCV_DUPLEX_MODE_FULL"/>					 
                    </v:var>
                    <v:var name="EthTrcvIdx" type="INTEGER">
                      <a:a name="DESC" 
                           value="EN: Specifies the instance ID of the configured transceiver."/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="SCOPE" value="ECU"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                      <a:a name="UUID" 
                           value="ECUC:ab0f21d9-5436-461b-9ca0-78d7de0241be"/>
                      <a:da name="DEFAULT" value="0"/>
                      <a:da name="INVALID" type="Range">
                        <a:tst expr="&lt;=255"/>
                        <a:tst expr="&gt;=0"/>
                      </a:da>
                    </v:var>
                    <v:lst name="EthTrcvPhysLayerType">
                      <a:da name="MAX" value="1"/>
                      <v:var name="EthTrcvPhysLayerType" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Specifies the physical layer type of the Ethernet transceiver link."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:81771cad-ba53-4816-b35b-9609a172c5d8"/>
                        <a:da name="DEFAULT" 
                              value="TRCV_PHYS_LAYER_TYPE_100BASE_T1"/>
                        <a:da name="RANGE">
                          <a:v>TRCV_PHYS_LAYER_TYPE_1000BASE_T</a:v>
                          <a:v>TRCV_PHYS_LAYER_TYPE_1000BASE_T1</a:v>
                          <a:v>TRCV_PHYS_LAYER_TYPE_100BASE_T1</a:v>
                          <a:v>TRCV_PHYS_LAYER_TYPE_100BASE_TX</a:v>
                        </a:da>
                      </v:var>
                    </v:lst>
                    <v:lst name="EthTrcvPortMacLayerSpeed">
                      <a:da name="MAX" value="1"/>
                      <v:var name="EthTrcvPortMacLayerSpeed" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Defines the baud rate of the MAC layer."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="Link">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="Link">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:a366ec28-86cb-414c-8930-d922d97314f9"/>
                        <a:da name="DEFAULT" value="ETH_MAC_LAYER_SPEED_100M"/>
                        <a:da name="RANGE">
                          <a:v>ETH_MAC_LAYER_SPEED_100M</a:v>
                          <a:v>ETH_MAC_LAYER_SPEED_10G</a:v>
                          <a:v>ETH_MAC_LAYER_SPEED_10M</a:v>
                          <a:v>ETH_MAC_LAYER_SPEED_1G</a:v>
                        </a:da>
                      </v:var>
                    </v:lst>
                    <v:lst name="EthTrcvPortMacLayerSubType">
                      <a:da name="MAX" value="1"/>
                      <v:var name="EthTrcvPortMacLayerSubType" 
                             type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Defines the MAC layer subtype of a switch port"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="Link">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="Link">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:e934fec3-36f0-47a9-834d-4ff824faadc5"/>
                        <a:da name="DEFAULT" value="REDUCED"/>
                        <a:da name="RANGE">
                          <a:v>REDUCED</a:v>
                          <a:v>REVERSED</a:v>
                          <a:v>SERIAL</a:v>
                          <a:v>STANDARD</a:v>
                          <a:v>UNIVERSAL_SERIAL</a:v>
                        </a:da>
                      </v:var>
                    </v:lst>
                    <v:lst name="EthTrcvPortMacLayerType">
                      <a:da name="MAX" value="1"/>
                      <v:var name="EthTrcvPortMacLayerType" type="ENUMERATION">
                        <a:a name="DESC" 
                             value="EN: Defines the MAC layer type of the ethernet transceiver."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="Link">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="Link">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="POSTBUILDVARIANTMULTIPLICITY" value="true"/>
                        <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                        <a:a name="SCOPE" value="ECU"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:6ad9f1a8-e9f0-47de-9b90-291c6018047f"/>
                        <a:da name="DEFAULT" value="TRCV_MAC_LAYER_TYPE_XMII"/>
                        <a:da name="RANGE">
                          <a:v>TRCV_MAC_LAYER_TYPE_XGMII</a:v>
                          <a:v>TRCV_MAC_LAYER_TYPE_XMII</a:v>
                          <a:v>TRCV_MAC_LAYER_TYPE_XXGMII</a:v>
                        </a:da>
                      </v:var>
                    </v:lst>
                    <v:var name="EthTrcvSpeed" type="ENUMERATION">
                      <a:a name="DESC" 
                           value="EN: Specifies the speed of the Ethernet transceiver link in [MBit/s]. If AutoNegotiation is enabled this is the maximum speed advertised for Auto-Negotiation.In AM263Px only TRCV_SPEED_10 and TRCV_SPEED_100 is supported"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="Link">VariantLinkTime</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                      <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:d81bed14-8ea6-4745-a0bd-d00c51e7bf09"/>
                      <a:da name="DEFAULT" value="TRCV_SPEED_100"/>
                      <a:da name="RANGE">
                        <a:v>TRCV_SPEED_10</a:v>
                        <a:v>TRCV_SPEED_100</a:v>					
                      </a:da>
                    </v:var>
                    <v:lst name="EthTrcvWakeUpCallout">
                      <a:da name="MAX" value="1"/>
                      <v:var name="EthTrcvWakeUpCallout" type="FUNCTION-NAME">
                        <a:a name="DESC" 
                             value="EN: Configuration of the call-out name."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" 
                             value="ECUC:63fb7934-3761-4f0b-868c-63a63a9c76b6"/>
                      </v:var>
                    </v:lst>
                    <v:var name="EthTrcvEnableLoopback" type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Phy loopback enable- for Test purpose"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Texas Instruments"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:33b28cf0-63e9-4e7f-9834-c9cd4e21c698"/>
                      <a:da name="DEFAULT" value="true"/>
                    </v:var>
                    <v:var name="EthTrcvGigabitCapabilityEnabled" 
                           type="BOOLEAN">
                      <a:a name="DESC" 
                           value="EN: Phy loopback enable- for Test purpose"/>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                           type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                        <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Texas Instruments"/>
                      <a:a name="SCOPE" value="LOCAL"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" 
                           value="ECUC:2561fe49-9e78-43a7-9772-87d2067071d7"/>
                      <a:da name="DEFAULT" value="true"/>
                    </v:var>
                    <v:lst name="EthTrcvIcuChannelRef">
                      <a:da name="MAX" value="1"/>
                      <v:ref name="EthTrcvIcuChannelRef" 
                             type="SYMBOLIC-NAME-REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Reference to the IcuChannel to enable/disable the interrupts for wakeups."/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="ECUC:43f35c11-c0be-41a9-9a33-04b4fc5da344"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Icu/IcuConfigSet/IcuChannel"/>
                      </v:ref>
                    </v:lst>
                    <v:lst name="EthTrcvPhyAdvertiseCapability">
                      <a:da name="MAX" value="32"/>
                      <v:ref name="EthTrcvPhyAdvertiseCapability" 
                             type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Phy advertisement capability"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Texas Instruments"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="ECUC:5348af77-3507-4882-b2b8-8e634491dddc"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/TI_AM263Px/EthTrcv/EthTrcvConfigSet/EthTrcvConfig/EthTrcvCapabType"/>
                      </v:ref>
                    </v:lst>
                    <v:lst name="EthTrcvLinkPartnerCapability">
                      <a:da name="MAX" value="32"/>
                      <v:ref name="EthTrcvLinkPartnerCapability" 
                             type="REFERENCE">
                        <a:a name="DESC" 
                             value="EN: Phy advertisement capability"/>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v mclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                          <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                          <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                          <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Texas Instruments"/>
                        <a:a name="SCOPE" value="LOCAL"/>
                        <a:a name="UUID" 
                             value="ECUC:4c3cd7dd-7f68-4ef4-a7ff-a07f5f019383"/>
                        <a:da name="REF" 
                              value="ASPathDataOfSchema:/TI_AM263Px/EthTrcv/EthTrcvConfigSet/EthTrcvConfig/EthTrcvCapabType"/>
                      </v:ref>
                    </v:lst>
                    <v:lst name="EthTrcvDemEventParameterRefs" type="MAP">
                      <a:da name="MAX" value="1"/>
                      <v:ctr name="EthTrcvDemEventParameterRefs" 
                             type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: Container for the references to DemEventParameter elements which shall be invoked using the API Dem_SetEventStatus in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId symbolic value. The standardized errors are provided in this container and can be extended by vendor-specific error references."/>
                        <a:a name="UUID" 
                             value="ECUC:2af9bb19-240d-4071-94c5-e501bd0ddd51"/>
                        <v:lst name="ETHTRCV_E_ACCESS">
                          <a:da name="MAX" value="1"/>
                          <v:ref name="ETHTRCV_E_ACCESS" 
                                 type="SYMBOLIC-NAME-REFERENCE">
                            <a:a name="DESC" 
                                 value="EN: Reference to the DemEventParameter which shall be issued when the error &quot;Transceiver access failed&quot; has occurred."/>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                                 type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v mclass="Link">VariantLinkTime</icc:v>
                              <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                              <icc:v vclass="Link">VariantLinkTime</icc:v>
                              <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                              <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="POSTBUILDVARIANTMULTIPLICITY" 
