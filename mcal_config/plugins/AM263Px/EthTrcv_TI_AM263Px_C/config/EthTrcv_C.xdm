                            <a:v>ETHTRCV_WUR_INTERNAL</a:v>
                            <a:v>ETHTRCV_WUR_PIN</a:v>
                            <a:v>ETHTRCV_WUR_POWER_ON</a:v>
                            <a:v>ETHTRCV_WUR_RESET</a:v>
                            <a:v>ETHTRCV_WUR_SYSERR</a:v>
                          </a:da>
                        </v:var>
                        <v:var name="EthTrcvWakeupReason1" type="ENUMERATION">
