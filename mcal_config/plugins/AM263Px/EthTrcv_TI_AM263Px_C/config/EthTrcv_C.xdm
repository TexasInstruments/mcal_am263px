                  <a:da name="DEFAULT" value="160000"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4294967295"/>
                    <a:tst expr="&gt;=1"/>
                  </a:da>
                </v:var>
                <v:var name="EthTrcvInternalLoopbackMode" type="ENUMERATION">
                  <a:a name="DESC" 
                       value="EN: Configures Internal Loopback mode to Analog or Digital."/>
