                      <v:ctr name="EthTrcvWakeupMap" type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: Container for the mapping of wake up reasons to wake up sources. At least one container is needed if EthTrcvWakeUpSupport is not ETHTRCV_WAKEUP_NOT_SUPPORTED."/>
                        <a:a name="UUID" 
