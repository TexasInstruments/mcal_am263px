              </v:ctr>
              <v:ctr name="EthTrcvGeneral" type="IDENTIFIABLE">
                <a:a name="DESC" 
                     value="EN: General configuration of Ethernet Transceiver Driver module"/>
                <a:a name="UUID" 
                     value="ECUC:2bddd3f0-92b8-4242-9d7e-882c8b5c5242"/>
                <v:var name="EthTrcvAutoNegotiationWaitCountTicks" 
                       type="INTEGER">
                  <a:a name="DESC">
                    <a:v>EN: Ethernet Tranceiver Tranceiver delay after autonetotiation
                       started to autonegotiation completed. Transceiver (PHY) sets auto-negotiation status bit in
                       status register once it is complete. Depending on Transceiver type,
                       MDIO frequence it will take different time. change count value if
                       transceiver detection fails in auto-negotiation.
                       For auto-negotiation configuring wait count to 100ms</a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Texas Instruments"/>
                  <a:a name="UUID" 
                       value="ECUC:e44ba532-e3ed-4281-82d0-58f3fa58bf0f"/>
                  <a:da name="DEFAULT" value="80000"/>
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4294967295"/>
                    <a:tst expr="&gt;=0"/>
                  </a:da>
                </v:var>
                <v:var name="EthTrcvDevErrorDetect" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Switches the development error detection and notification on or off."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                    <icc:v vclass="PreCompile">VariantPostBuild</icc:v>
                    <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SCOPE" value="LOCAL"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" 
                       value="ECUC:7b804b66-735b-4bea-b975-2a28fa59ff71"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="EthTrcvGetBaudRateApi" type="BOOLEAN">
                  <a:a name="DESC" 
                       value="EN: Enables / Disables EthTrcv_GetBaudRate API"/>
